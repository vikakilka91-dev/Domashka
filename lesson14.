# ==========================================
# ПУНКТ 1: Создать list из 10 чисел, вывести четные через comprehension
# ==========================================
print("--- Пункт 1: List Comprehension ---")
# Создаем список от 1 до 10
nums = list(range(1, 11)) 
# Используем list comprehension для фильтрации четных
even_nums = [x for x in nums if x % 2 == 0]
print("Исходный список:", nums)
print("Четные числа:", even_nums)


# ==========================================
# ПУНКТ 2: Создать dict товар-цена, добавить 3 пары, обновить, вывести items
# ==========================================
print("\n--- Пункт 2: Словари (dict) ---")
user = {"яблоко": 50, "банан": 30, "апельсин": 70}
print("Исходный словарь:", user)

# Добавляем 3 новые пары
user["груша"] = 60
user["киви"] = 40
user["манго"] = 120

# Обновляем одну пару (изменяем цену яблока)
user["яблоко"] = 55

# Выводим ключи и значения через .items()
print("Обновленный словарь (items):")
for key, value in user.items():
    print(f"  {key}: {value}")


# ==========================================
# ПУНКТ 3: Создать set из списка с дублями, проверить вхождение через in
# ==========================================
print("\n--- Пункт 3: Множества (set) ---")
list_with_duplicates = [1, 2, 2, 3, 4, 4, 4, 5]
# Преобразование в set удаляет дубликаты
tags = set(list_with_duplicates)
print("Исходный список с дублями:", list_with_duplicates)
print("Множество (без дублей):", tags)

# Проверка вхождения
check_item = 3
if check_item in tags:
    print(f"Элемент {check_item} найден в множестве.")
else:
    print(f"Элемента {check_item} нет в множестве.")


# ==========================================
# ПУНКТ 4: Создать tuple координат, попробовать изменить, поймать TypeError
# ==========================================
print("\n--- Пункт 4: Кортежи (tuple) ---")
point = (10.5, 20.3)
print("Координаты:", point)

try:
    # Пытаемся изменить элемент кортежа (это вызовет ошибку)
    point[0] = 15.0
except TypeError as e:
    print(f"Поймана ошибка TypeError: {e}")
    print("Кортежи неизменяемы, изменить элемент нельзя.")


# ==========================================
# ПУНКТ 5: Сравнить цикл и comprehension (квадраты чисел)
# ==========================================
print("\n--- Пункт 5: Цикл vs Comprehension ---")
n = 5

# Обычный цикл
squares_loop = []
for i in range(1, n + 1):
    squares_loop.append(i ** 2)

# List comprehension
squares_comp = [i ** 2 for i in range(1, n + 1)]

print("Через цикл for:", squares_loop)
print("Через comprehension:", squares_comp)
print("Результаты идентичны:", squares_loop == squares_comp)


# ==========================================
# ПРОВЕРКА ИЗ ЗАДАНИЯ (Ассерты)
# ==========================================
print("\n--- Проверка типов ---")
assert isinstance(nums, list), "nums должен быть list"
assert isinstance(user, dict), "user должен быть dict"
assert isinstance(tags, set), "tags должен быть set"
assert isinstance(point, tuple), "point должен быть tuple"
print("OK")
